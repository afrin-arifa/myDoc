APP_NAME=myDoc
APP_ENV=local
# Generate once with `php artisan key:generate` and never change it in production: it encrypts sessions and the
# stored Google Calendar tokens. To rotate, move the old key to APP_PREVIOUS_KEYS (comma-separated).
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mydoc
DB_USERNAME=
DB_PASSWORD=
# MySQL session time zone; must match the application time zone (Asia/Dhaka). Do not change.
DB_TIMEZONE=+06:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Never "sync" in production: notification and calendar delivery must be retried in the background.
QUEUE_CONNECTION=database
# Seconds before an unfinished job is handed to another worker. Keep above the longest job timeout (60 s).
DB_QUEUE_RETRY_AFTER=90

# Scheduler overlap locks and Google Calendar sync locks live here: use a store shared by every server
# (database or redis), never file or array, when running more than one server.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP socket timeout in seconds; keep below the email job timeout (45 s). Use a real SMTP server in production:
# with MAIL_MAILER=log, emails (including invitation and password-reset links) are only written to the log.
MAIL_TIMEOUT=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Appointment SMS (P1.5). Leave SMS_DRIVER=none until a provider account is ready.
SMS_DRIVER=none
SMS_SENDER_ID=
BULKSMSBD_API_KEY=
BULKSMSBD_BASE_URL=https://bulksmsbd.net/api
SMS_TIMEOUT=10
SMS_CONNECT_TIMEOUT=5
SMS_REMINDER_HOURS=24,2
SMS_REMINDER_WINDOW_MINUTES=60

# Google Calendar (doctors connect their own calendar). Create an OAuth "Web application" client in Google Cloud,
# enable the Google Calendar API, and register GOOGLE_CALENDAR_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/doctor/google-calendar/callback"
GOOGLE_CALENDAR_TIMEOUT=10
GOOGLE_CALENDAR_CONNECT_TIMEOUT=5

# Voice and video consultations need a call provider (Release 2). Keep false until one is configured.
BOOKING_REMOTE_CONSULTATIONS=false
